---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Mattress Buying Guides | Fort Myers Mattress By Appointment"
  description="Honest mattress buying guides from a Fort Myers dealer. Back pain, Florida humidity, brand comparisons, financing — written by people who sell the beds."
>
  <section class="py-10 sm:py-14 md:py-20 bg-gradient-to-br from-blue-50 via-white to-gray-50">
    <div class="container-narrow text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6">
        Mattress Buying Guides
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-gray-600 max-w-2xl mx-auto px-4">
        Honest answers to the questions Fort Myers shoppers actually ask. Written by the people who sell the mattresses, not a content marketing agency.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14 md:py-16 bg-white">
    <div class="container-narrow">
      <div class="grid sm:grid-cols-2 gap-6 sm:gap-8">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group block bg-white border border-gray-200 rounded-2xl p-6 sm:p-7 hover:border-accent hover:shadow-lg transition-all duration-200 touch-active"
          >
            <p class="text-xs sm:text-sm text-gray-500 mb-2">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 group-hover:text-accent transition-colors mb-3">
              {post.data.title}
            </h2>
            <p class="text-gray-600 text-sm sm:text-base mb-4">
              {post.data.description}
            </p>
            <span class="inline-flex items-center text-accent font-semibold text-sm group-hover:gap-2 gap-1 transition-all">
              Read guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-accent">
    <div class="container-narrow text-center">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
        Have a question we haven't answered?
      </h2>
      <p class="text-base sm:text-lg text-white/90 mb-6 sm:mb-8 max-w-xl mx-auto px-4">
        Book a free 30-minute appointment and we'll answer it in person — no pressure, no obligation.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center px-4 sm:px-0">
        <a href="/book" class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-white text-accent font-semibold rounded-lg hover:bg-gray-100 transition-colors text-base sm:text-lg w-full sm:w-auto touch-active">
          Book Appointment
        </a>
      </div>
    </div>
  </section>
</Layout>
