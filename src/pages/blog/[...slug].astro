---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const pageUrl = `${siteConfig.siteUrl}/blog/${post.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    '@id': `${siteConfig.siteUrl}/#organization`,
    name: post.data.author,
  },
  publisher: {
    '@id': `${siteConfig.siteUrl}/#organization`,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  keywords: post.data.keywords.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteConfig.siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
  ],
};
---

<Layout title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="py-10 sm:py-14 md:py-20 bg-white">
    <div class="container-narrow max-w-3xl">
      <nav class="text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-accent">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-accent">Blog</a>
      </nav>

      <header class="mb-8 sm:mb-10">
        <p class="text-xs sm:text-sm text-gray-500 mb-3">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.updatedDate && (
            <>
              <span class="mx-2">·</span>
              Updated {post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </>
          )}
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
          {post.data.title}
        </h1>
        <p class="text-base sm:text-lg text-gray-600">
          {post.data.description}
        </p>
      </header>

      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-p:text-gray-700 prose-p:leading-relaxed prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-table:text-sm prose-th:bg-gray-50">
        <Content />
      </div>

      <div class="mt-12 sm:mt-16 p-6 sm:p-8 bg-blue-50 rounded-2xl">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">Ready to find your mattress?</h2>
        <p class="text-gray-600 mb-5 text-sm sm:text-base">
          Book a free, private 30-minute appointment at our Fort Myers showroom. No pressure, no obligation.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/book" class="btn-primary text-base px-6 py-3 w-full sm:w-auto touch-active">
            Book Appointment
          </a>
          <a href={`tel:${siteConfig.phoneRaw}`} class="btn-secondary text-base px-6 py-3 w-full sm:w-auto touch-active">
            Call {siteConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
