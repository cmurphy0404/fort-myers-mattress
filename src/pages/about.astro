---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import FAQSchema from '../components/FAQSchema.astro';
import ownersImage from '../assets/owners-mike-karen.jpg';
import { siteConfig } from '../config';
---

<Layout
  title="About Fort Myers Mattress | By-Appointment Showroom"
  description="Fort Myers Mattress By Appointment — save 50-80% off retail in our private showroom. No pressure. Same-day delivery to Fort Myers & Southwest FL."
>
  <FAQSchema slot="head" />
  <!-- Hero -->
  <section class="section-padding bg-gradient-to-br from-blue-50 via-white to-gray-50">
    <div class="container-narrow text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6">
        About Us
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-gray-600 max-w-2xl mx-auto px-4 sm:px-0">
        The best and cheapest way to buy a mattress in Fort Myers.
      </p>
    </div>
  </section>

  <!-- About Content -->
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <div class="grid md:grid-cols-2 gap-6 sm:gap-8 md:gap-12 items-center">
        <div>
          <img
            src="/images/about-consultation.png"
            alt="Friendly, casual mattress consultation in a local Fort Myers store"
            class="rounded-2xl shadow-lg w-full h-auto object-cover aspect-[4/3]"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 sm:mb-6">
            Why Appointment-Based Shopping?
          </h2>
          <div class="prose prose-base sm:prose-lg text-gray-600">
            <p class="mb-3 sm:mb-4 text-sm sm:text-base">
              We've been serving Southwest Florida for over 10 years with a simple philosophy: cut the overhead, pass the savings to you. That's why our customers typically save 50-80% off retail prices.
            </p>
            <p class="mb-3 sm:mb-4 text-sm sm:text-base">
              When you book an appointment, you get the showroom to yourself. No crowds, no pushy salespeople, no rush. Just you, a curated selection of quality mattresses from brands like Tempur+Sealy, Diamond Mattress, Brooklyn Bedding, and Malouf, and honest guidance to help you find the right fit.
            </p>
            <p class="text-sm sm:text-base">
              We offer same-day delivery throughout Fort Myers, Cape Coral, Naples, Bonita Springs, Estero, and Lehigh Acres. Need financing? Just $20 down gets you started — no credit check needed.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Offer -->
  <section class="section-padding bg-gray-50">
    <div class="container-narrow">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6 sm:mb-8 text-center">
        What Sets Us Apart
      </h2>
      <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="bg-white p-5 sm:p-6 rounded-xl shadow-sm">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-accent/10 rounded-full flex items-center justify-center mb-3 sm:mb-4">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">Personal Attention</h3>
          <p class="text-gray-600 text-xs sm:text-sm">
            One-on-one appointments mean you get undivided attention and recommendations tailored to your needs.
          </p>
        </div>
        <div class="bg-white p-5 sm:p-6 rounded-xl shadow-sm">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-accent/10 rounded-full flex items-center justify-center mb-3 sm:mb-4">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">No Pressure</h3>
          <p class="text-gray-600 text-xs sm:text-sm">
            Take your time. Test mattresses without feeling rushed or pressured to make a decision.
          </p>
        </div>
        <div class="bg-white p-5 sm:p-6 rounded-xl shadow-sm">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-accent/10 rounded-full flex items-center justify-center mb-3 sm:mb-4">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">Cheapest Prices</h3>
          <p class="text-gray-600 text-xs sm:text-sm">
            Save 50-80% off retail prices. We pass our low overhead savings directly to you.
          </p>
        </div>
        <div class="bg-white p-5 sm:p-6 rounded-xl shadow-sm">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-accent/10 rounded-full flex items-center justify-center mb-3 sm:mb-4">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">Local Service</h3>
          <p class="text-gray-600 text-xs sm:text-sm">
            Serving Fort Myers, Cape Coral, and Southwest Florida. Local pickup and delivery available.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Owner / E-E-A-T Section -->
  <section class="section-padding bg-white border-t border-gray-100">
    <div class="container-narrow">
      <div class="text-center mb-8 sm:mb-10">
        <p class="text-accent text-xs sm:text-sm font-semibold tracking-wider uppercase mb-2">Family-Owned · Husband & Wife Team</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-3 sm:mb-4">
          Meet Mike &amp; Karen
        </h2>
        <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto px-4">
          The owners you'll actually meet when you book your appointment.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 md:gap-10 lg:gap-14 items-center max-w-5xl mx-auto">
        <div class="order-1 md:order-1">
          <Image
            src={ownersImage}
            alt="Mike and Karen, husband-and-wife owners of Fort Myers Mattress By Appointment"
            class="rounded-2xl shadow-xl w-full h-auto object-cover aspect-[4/5] md:aspect-[3/4]"
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 400px, 100vw"
            format="webp"
            quality={84}
            loading="lazy"
          />
        </div>
        <div class="order-2 md:order-2">
          <div class="prose prose-base sm:prose-lg max-w-none text-gray-700">
            <p class="mb-4">
              For 10 years, we've been more than just a mattress store — we've been a part of the Fort Myers community. As a husband-and-wife team, we founded Fort Myers Mattress by Appointment with a simple mission: to provide a personal, stress-free shopping experience that helps our neighbors get the quality rest they deserve.
            </p>
            <p class="mb-0">
              When you visit us at <strong>2950 Winkler Ave, Suite 601</strong>, you're working directly with the owners. Karen handles our digital marketing and keeps the community informed on the latest deals. Mike is often out personally managing deliveries to make sure your new bed arrives safely and on time.
            </p>
          </div>
        </div>
      </div>

      <div class="max-w-5xl mx-auto mt-10 sm:mt-12 md:mt-14">
        <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6 text-center">What Makes Us Different</h3>
        <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="bg-gray-50 rounded-xl p-5 sm:p-6">
            <div class="w-10 h-10 bg-accent/10 rounded-full flex items-center justify-center mb-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">A Decade of Local Expertise</h4>
            <p class="text-gray-600 text-xs sm:text-sm">Ten years mastering the mattress industry — we'll help you find the perfect fit for your sleep style and budget.</p>
          </div>
          <div class="bg-gray-50 rounded-xl p-5 sm:p-6">
            <div class="w-10 h-10 bg-accent/10 rounded-full flex items-center justify-center mb-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">Family Owned &amp; Operated</h4>
            <p class="text-gray-600 text-xs sm:text-sm">We've raised our four children here in Florida. We treat every person who walks through our door like a neighbor — never a sales goal.</p>
          </div>
          <div class="bg-gray-50 rounded-xl p-5 sm:p-6">
            <div class="w-10 h-10 bg-accent/10 rounded-full flex items-center justify-center mb-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">Service You Can Trust</h4>
            <p class="text-gray-600 text-xs sm:text-sm">From sponsoring local school programs to handling our own store maintenance, we're fully invested in the Fort Myers area.</p>
          </div>
          <div class="bg-gray-50 rounded-xl p-5 sm:p-6">
            <div class="w-10 h-10 bg-accent/10 rounded-full flex items-center justify-center mb-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-gray-900 mb-2 text-sm sm:text-base">A Personal Touch</h4>
            <p class="text-gray-600 text-xs sm:text-sm">Not a big-box chain. You get the honesty, care, and attention to detail that only a local family business can provide.</p>
          </div>
        </div>
      </div>

      <div class="max-w-3xl mx-auto mt-10 sm:mt-12 text-center">
        <p class="text-base sm:text-lg text-gray-700 mb-6 italic">
          "We believe a great day starts with a great night's sleep. Come see why Mike and Karen have been the trusted choice for mattresses in Fort Myers for over a decade."
        </p>
        <a href={`tel:${siteConfig.phoneRaw}`} class="inline-flex items-center text-accent font-semibold text-base sm:text-lg hover:underline">
          Talk to Mike or Karen: {siteConfig.phone}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ />

  <!-- CTA -->
  <section class="section-padding bg-accent">
    <div class="container-narrow text-center">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
        Ready to Find Your Perfect Mattress?
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-white/90 mb-6 sm:mb-8 max-w-2xl mx-auto px-4 sm:px-0">
        Book your appointment today and experience mattress shopping the way it should be.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center px-4 sm:px-0">
        <a href="/book" class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-white text-accent font-semibold rounded-lg hover:bg-gray-100 active:bg-gray-200 transition-colors text-base sm:text-lg w-full sm:w-auto touch-active">
          Book Appointment
        </a>
        <a href={`tel:${siteConfig.phoneRaw}`} class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-transparent text-white font-semibold rounded-lg border-2 border-white hover:bg-white/10 active:bg-white/20 transition-colors text-base sm:text-lg w-full sm:w-auto touch-active">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {siteConfig.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
