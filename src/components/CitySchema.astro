---
import { siteConfig } from '../config';

interface Props {
  city: string;
  pageUrl: string;
}

const { city, pageUrl } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteConfig.siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${city} Mattress Store`,
      item: pageUrl,
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Mattress Sales and Delivery in ${city}, FL`,
  serviceType: 'Mattress Retail and Same-Day Delivery',
  provider: {
    '@id': `${siteConfig.siteUrl}/#business`,
  },
  areaServed: {
    '@type': 'City',
    name: city,
    addressRegion: 'FL',
    addressCountry: 'US',
  },
  description: `Save 50-80% off retail on quality mattresses delivered to ${city}, FL. Private, by-appointment shopping at our Fort Myers showroom. Same-day delivery available. Top brands including Tempur and Diamond.`,
  offers: {
    '@type': 'Offer',
    priceRange: '$$',
    availability: 'https://schema.org/InStock',
    areaServed: {
      '@type': 'City',
      name: city,
      addressRegion: 'FL',
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
