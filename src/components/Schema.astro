---
import { siteConfig } from '../config';

const socialLinks = Object.values(siteConfig.socials).filter(Boolean);

const extendedAreaServed = [
  ...siteConfig.areaServed,
  'Punta Gorda',
  'Port Charlotte',
  'Marco Island',
  'Sanibel',
  'Captiva',
  'Immokalee',
  'Ave Maria',
  'Golden Gate',
  'North Fort Myers',
  'Pine Island',
  'Labelle',
  'Clewiston',
  'Arcadia',
  'Englewood',
  'Venice',
  'Sarasota',
  'Bradenton',
  'North Naples',
  'Collier County',
  'Lee County',
  'Charlotte County',
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'FurnitureStore', 'Store'],
  '@id': `${siteConfig.siteUrl}/#business`,
  name: siteConfig.businessName,
  alternateName: ['Fort Myers Mattress', 'Fort Myers Mattress Store', 'Mattress By Appointment Fort Myers'],
  description: 'The best place to buy affordable, quality mattresses in Fort Myers and Southwest Florida. Save 50-80% off retail prices with private, by-appointment shopping. Featuring Tempur, Diamond and other top brands. Same day delivery available. Serving Fort Myers, Cape Coral, Naples, Bonita Springs, Estero, and Lehigh Acres.',
  slogan: 'Best mattress deals in Southwest Florida — 50-80% off retail prices',
  url: siteConfig.siteUrl,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.city,
    addressRegion: siteConfig.address.state,
    postalCode: siteConfig.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 26.5838637,
    longitude: -81.8579749,
  },
  hasMap: siteConfig.googleMapsLink,
  areaServed: [
    {
      '@type': 'GeoCircle',
      geoMidpoint: {
        '@type': 'GeoCoordinates',
        latitude: 26.5838637,
        longitude: -81.8579749,
      },
      geoRadius: '120700',
    },
    ...extendedAreaServed.map((area) => ({
      '@type': 'City',
      name: area,
      addressRegion: 'FL',
      addressCountry: 'US',
    })),
  ],
  priceRange: '$$',
  paymentAccepted: 'Cash, Credit Card, Financing',
  currenciesAccepted: 'USD',
  image: `${siteConfig.siteUrl}/images/MBA-MainHorizontalLogo-Red_Gray.png`,
  logo: `${siteConfig.siteUrl}/images/MBA-MainHorizontalLogo-Red_Gray.png`,
  sameAs: socialLinks.length > 0 ? socialLinks : undefined,
  byAppointmentOnly: true,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Mattresses and Sleep Products',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Memory Foam Mattresses', brand: 'Tempur' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Hybrid Mattresses', brand: 'Diamond' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Pillow Top Mattresses' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Adjustable Bases' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Pillows' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Mattress Protectors' } },
    ],
  },
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'Same-Day Mattress Delivery',
      areaServed: extendedAreaServed.map((area) => ({ '@type': 'City', name: area })),
    },
    {
      '@type': 'Offer',
      name: 'No-Credit-Needed Financing',
      description: 'Payment plans starting at $20 down — no credit check required.',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    bestRating: '5',
    worstRating: '1',
    ratingCount: '169',
    reviewCount: '169',
  },
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteConfig.siteUrl}/#website`,
  url: siteConfig.siteUrl,
  name: siteConfig.businessName,
  publisher: {
    '@id': `${siteConfig.siteUrl}/#business`,
  },
  inLanguage: 'en-US',
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteConfig.siteUrl}/#webpage`,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'h2', '.speakable'],
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteConfig.siteUrl}/#organization`,
  name: siteConfig.businessName,
  url: siteConfig.siteUrl,
  logo: `${siteConfig.siteUrl}/images/MBA-MainHorizontalLogo-Red_Gray.png`,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: siteConfig.phone,
    contactType: 'sales',
    areaServed: 'US-FL',
    availableLanguage: ['English'],
  },
  sameAs: socialLinks.length > 0 ? socialLinks : undefined,
};
---

<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
